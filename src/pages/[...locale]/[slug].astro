---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectDetailPage from '../../components/pages/ProjectDetailPage.astro';
import { locales, type Locale, normalizeLocale } from '../../i18n/ui';
import { getCanonicalProjectGroups } from '../../lib/projects';
import { getLocalizedPage, pageSlugOf } from '../../lib/content';
import { reservedSlugs } from '../../i18n/config.mjs';

export async function getStaticPaths() {
  const projects = getCanonicalProjectGroups(await getCollection('projects'));
  const pages = await getCollection('pages', (page) => !page.data.draft);

  const extendedLocales = [...locales, undefined];

  const projectPaths = extendedLocales.flatMap((locale) =>
    projects.map((project) => ({
      params: { locale, slug: project.data.routeSlug.toLowerCase() },
      props: { type: 'project', slug: project.data.routeSlug.toLowerCase() },
    }))
  );

  const pageSlugSet = new Set(
    pages
      .map(pageSlugOf)
      .filter((slug) => slug && !reservedSlugs.includes(slug))
  );

  for (const project of projects) {
    const slug = project.data.routeSlug.toLowerCase();
    if (reservedSlugs.includes(slug) || pageSlugSet.has(slug)) {
      throw new Error(`URL déjà utilisée pour le projet : /${slug}/`);
    }
  }

  const pagePaths = extendedLocales.flatMap((locale) =>
    [...pageSlugSet].map((pageSlug) => ({
      params: { locale, slug: pageSlug },
      props: { type: 'page', slug: pageSlug },
    }))
  );

  return [...projectPaths, ...pagePaths];
}

import path from 'node:path';

const { type, slug } = Astro.props;
const locale = normalizeLocale(Astro.params.locale) as Locale;

let pageData = null;
let Content = null;
let sourcePath: string | undefined;

if (type === 'page') {
  const pageEntry = await getLocalizedPage(locale, slug);

  if (pageEntry) {
    pageData = pageEntry.data;
    const rendered = await render(pageEntry);
    Content = rendered.Content;
    sourcePath = pageEntry.filePath ? path.resolve(process.cwd(), pageEntry.filePath) : undefined;
  }
}
---
{type === 'project' ? (
  <ProjectDetailPage locale={locale} slug={slug} />
) : pageData ? (
  <BaseLayout locale={locale} title={`${pageData.title} · patrick jeuniaux`} description={pageData.lead} sourcePath={sourcePath} autoTranslated={pageData.autoTranslated} publishedAt={pageData.publishedAt} updatedAt={pageData.updatedAt}>
    <section class="section">
      <div class="container">
        <h1 class="page-title">{pageData.title}</h1>
        {pageData.lead && <p class="lead">{pageData.lead}</p>}
        <div class="prose prose-wide">
          {Content && <Content />}
        </div>
      </div>
    </section>
  </BaseLayout>
) : null}
