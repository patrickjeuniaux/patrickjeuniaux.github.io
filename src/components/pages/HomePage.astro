---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import { t, type Locale, localizePath, normalizeLocale } from '../../i18n/ui';
import { getLocalizedPage } from '../../lib/content';
import { getLocalizedBlogGroups, slugOf } from '../../lib/blog';

interface Props { locale: Locale }
const locale = normalizeLocale(Astro.props.locale);
const s = t(locale);
const homeEntry = await getLocalizedPage(locale, 'home');
if (!homeEntry) throw new Error('home page content not found');
const home = homeEntry.data;
const datEntry = await getLocalizedPage(locale, 'dat');
const markdown = await createMarkdownProcessor({ smartypants: false });
const renderInline = async (text: unknown) => {
  const { code } = await markdown.render(String(text ?? ''));
  return code.trim().replace(/^<p>/, '').replace(/<\/p>$/, '');
};
const axisColors = ['brown', 'blue', 'green', 'gold', 'brown'];
const axes = axisColors.map((color, index) => ({
  color,
  title: home[`axis${index + 1}Title`],
  text: home[`axis${index + 1}Text`],
})).filter((axis) => axis.title && axis.text);
const [leadHtml, ...axisHtml] = await Promise.all([
  home.lead,
  ...axes.map((axis) => axis.text),
].map(renderInline));
const navigation = [
  { href: '/about/', title: s.nav.about, text: home.aboutText },
  ...(datEntry ? [{ href: '/dat/', title: datEntry.data.navTitle ?? datEntry.data.title, text: home.datText }] : []),
  { href: '/projects/', title: s.nav.projects, text: home.projectsText },
  { href: '/work/', title: s.nav.work, text: home.workText },
  { href: '/notes/', title: s.nav.notes, text: home.notesText },
  { href: '/collaborations/', title: s.nav.collaborations, text: home.collaborationsText },
  { href: '/contact/', title: s.nav.contact, text: home.contactText },
].filter((link) => link.text);

// Latest 5 blog posts, reverse-chrono
const allPosts = await getCollection('blog');
const latestPosts = getLocalizedBlogGroups(
  allPosts.filter(p => !p.data.draft),
  locale
).slice(0, 5);

import { localeDateFormat } from '../../i18n/ui';
import path from 'node:path';

const dateLocale = localeDateFormat(locale);
const formatDate = (date: Date) =>
  date.toLocaleDateString(dateLocale, { day: 'numeric', month: 'short', year: 'numeric' });

const sourcePath = homeEntry.filePath ? path.resolve(process.cwd(), homeEntry.filePath) : undefined;
const sourcePaths = [datEntry, ...latestPosts].flatMap((entry) => entry?.filePath ? [path.resolve(process.cwd(), entry.filePath)] : []);
---
<BaseLayout locale={locale} title="patrick jeuniaux" description={home.lead || s.siteDescription} sourcePath={sourcePath} sourcePaths={sourcePaths} autoTranslated={homeEntry.data.autoTranslated} publishedAt={homeEntry.data.publishedAt} updatedAt={homeEntry.data.updatedAt}>
  <section class="hero hero-banner">
    <div class="hero-banner-image" role="img" aria-label={s.heroImageDescription}></div>
    <div class="container hero-grid">
      <div class="hero-panel">
        <div class="kicker">{home.kicker}</div>
        <h1 class="page-title page-title-icon hero-title" data-icon="⚓">{home.title}</h1>
        <p class="lead dropcap" set:html={leadHtml} />
      </div>
      <aside class="hero-card card-accent-blue">
        <p class="section-mark">{home.newsTitle}</p>
        {latestPosts.length > 0 ? (
          <ul class="list-clean news-list">
            {latestPosts.map(post => (
              <li>
                <span class="news-date">{formatDate(post.data.date)}</span>
                <a href={localizePath(locale, `/notes/${slugOf(post)}/`)} class="news-link">{post.data.title}</a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="meta">—</p>
        )}
        <p style="margin-top: 0.9rem; margin-bottom: 0;">
          <a href={localizePath(locale, '/notes/')} class="meta">{home.newsLink}</a>
        </p>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>{home.axesTitle}</h2>
      <div class="grid-axes">
        {axes.map((axis, index) => (
          <article class={`card card-accent-${axis.color}`}><h3>{axis.title}</h3><p set:html={axisHtml[index]} /></article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container stack-gap">
      {navigation.length > 0 && <div>
        <h2>{home.navTitle}</h2>
        <ul class="list-clean nav-list">
          {navigation.map((link) => (
            <li><a href={localizePath(locale, link.href)}>{link.title}</a> <span class="meta">{link.text}</span></li>
          ))}
        </ul>
      </div>}
      {home.editorialText && <div class="card card-accent-gold">
        <p class="section-mark">{home.editorial}</p>
        <p>{home.editorialText}</p>
      </div>}
    </div>
  </section>
</BaseLayout>
