---
import '../styles/global.css';
import { t, type Locale, defaultLocale, localizePath, localizedCurrentPath, localeLabels, locales, normalizeLocale } from '../i18n/ui';
import { getContentDates, formatFooterDate } from '../lib/utils';
import { getExtraNavigation } from '../lib/content';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  translations?: Record<string, string>;
  sourcePath?: string;
  sourcePaths?: string[];
  publishedAt?: Date;
  updatedAt?: Date;
  autoTranslated?: boolean;
}

const { title, locale: rawLocale = 'fra', description, translations, sourcePath, sourcePaths = [], publishedAt, updatedAt, autoTranslated = false } = Astro.props;
const locale = normalizeLocale(rawLocale);
const s = t(locale);
const metaDescription = description ?? s.siteDescription;
const currentPath = Astro.url.pathname;

const getLink = (targetLocale: Locale) => {
  if (translations && translations[targetLocale]) return translations[targetLocale];
  return localizedCurrentPath(currentPath, targetLocale);
};

const fileDates = getContentDates(sourcePath, sourcePaths);
const publicationDate = publishedAt ?? fileDates?.birthtime;
const updateDate = updatedAt ?? fileDates?.mtime;
const extraNavigation = await getExtraNavigation(locale);
const datNavigation = extraNavigation.find((link) => link.href === localizePath(locale, '/dat/'));
const otherNavigation = extraNavigation.filter((link) => link !== datNavigation);
---
<!doctype html>
<html lang={locale} dir={locale === 'ara' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDescription} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header-inner">
        <div class="header-top-row">
          <a class="brand" href={localizePath(locale, '/')} aria-label="patrick p. j. m. h. jeuniaux">
            <span class="site-title">patrick p. j. m. h. jeuniaux</span>
            <small>{s.tagline}</small>
          </a>
          <nav class="nav" aria-label={s.primaryNavLabel}>
            <a href={localizePath(locale, '/about/')}>{s.nav.about}</a>
            {datNavigation && <a href={datNavigation.href}>{datNavigation.title}</a>}
            <a href={localizePath(locale, '/projects/')}>{s.nav.projects}</a>
            <a href={localizePath(locale, '/collaborations/')}>{s.nav.collaborations}</a>
            <a href={localizePath(locale, '/work/')}>{s.nav.work}</a>
            <a href={localizePath(locale, '/notes/')}>{s.nav.notes}</a>
            <a href={localizePath(locale, '/contact/')}>{s.nav.contact}</a>
            {otherNavigation.map((link) => <a href={link.href}>{link.title}</a>)}
          </nav>
        </div>
        <nav class="lang-switcher" aria-label={s.languageNavLabel}>
          {locales.map((targetLocale) => (
            <a href={getLink(targetLocale)} class:list={['lang-pill', locale === targetLocale && 'is-active']} hreflang={targetLocale} lang={targetLocale}>
              {localeLabels[targetLocale]}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <p class="footer-title">{s.footerTitle}</p>
          {s.footerText && <p class="meta">{s.footerText}</p>}
        </div>
        <div>
          <p class="meta">
            {(publicationDate || updateDate) && (
              <span class="date-info">
                {publicationDate && <span>{s.originalPublication}: <time datetime={publicationDate.toISOString()}>{formatFooterDate(publicationDate)}</time></span>}
                {publicationDate && updateDate && ' | '}
                {updateDate && <span>{s.lastUpdated}: <time datetime={updateDate.toISOString()}>{formatFooterDate(updateDate, !updatedAt)}</time></span>}
                <br />
              </span>
            )}
            {(autoTranslated || locale !== defaultLocale) && s.autoTranslated && (
              <span class="auto-translated">
                {s.autoTranslated}
                <br />
              </span>
            )}
            {s.footerBuild}
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
